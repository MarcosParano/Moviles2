<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moviles2.Views.MainPage"
             Title="Trámite Vigilador CABA"
             BackgroundColor="Black">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Habilitación de Vigilador" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" />

            <Entry Placeholder="Nombre del Solicitante" Text="{Binding NombreSolicitante}" BackgroundColor="#1E1E1E" TextColor="White" PlaceholderColor="LightGray" />

            <Label Text="Requisitos a presentar:" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" TextColor="White" />

            <!-- DNI -->
            <HorizontalStackLayout Spacing="10">
                <CheckBox IsChecked="{Binding TieneDNI}" Color="White" />
                <Label Text="DNI" VerticalOptions="Center" TextColor="White" />
            </HorizontalStackLayout>

            <!-- Biométricos con Fecha -->
            <VerticalStackLayout Spacing="5">
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding TieneBiometricos}" Color="White" />
                    <Label Text="Datos Biométricos" VerticalOptions="Center" TextColor="White" />
                </HorizontalStackLayout>
                <HorizontalStackLayout IsVisible="{Binding TieneBiometricos}" Spacing="10" Margin="50,0,0,0">
                    <Label Text="Realizado el:" VerticalOptions="Center" TextColor="LightGray"/>
                    <DatePicker Date="{Binding FechaBiometricos}" BackgroundColor="#1E1E1E" TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Secundario -->
            <HorizontalStackLayout Spacing="10">
                <CheckBox IsChecked="{Binding TieneSecundario}" Color="White" />
                <Label Text="Título Secundario" VerticalOptions="Center" TextColor="White" />
            </HorizontalStackLayout>

            <!-- Curso de Capacitación con Fecha -->
            <VerticalStackLayout Spacing="5">
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding TieneCurso}" Color="White" />
                    <Label Text="Curso de Capacitación" VerticalOptions="Center" TextColor="White" />
                </HorizontalStackLayout>
                <HorizontalStackLayout IsVisible="{Binding TieneCurso}" Spacing="10" Margin="50,0,0,0">
                    <Label Text="Aprobado el:" VerticalOptions="Center" TextColor="LightGray"/>
                    <DatePicker Date="{Binding FechaCurso}" BackgroundColor="#1E1E1E" TextColor="White"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Reincidencia con Fecha -->
            <VerticalStackLayout Spacing="5">
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding TieneReincidencia}" Color="White" />
                    <Label Text="Certificado de Reincidencia" VerticalOptions="Center" TextColor="White" />
                </HorizontalStackLayout>
                <HorizontalStackLayout IsVisible="{Binding TieneReincidencia}" Spacing="10" Margin="50,0,0,0">
                    <Label Text="Emitido el:" VerticalOptions="Center" TextColor="LightGray"/>
                    <DatePicker Date="{Binding FechaReincidencia}" BackgroundColor="#1E1E1E" TextColor="White"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Cuadro Dinámico de Faltantes -->
            <Border Stroke="Gray" StrokeThickness="2" BackgroundColor="#121212" StrokeShape="RoundRectangle 8" Padding="15" Margin="0,15,0,0">
                <Label Text="{Binding EstadoGeneral}" FontSize="15" FontAttributes="Bold" TextColor="#FFB347" />
            </Border>

            <!-- Botón de Guardar -->
            <Button Text="Guardar Avance" 
                    Command="{Binding GuardarCommand}" 
                    BackgroundColor="Blue" 
                    TextColor="White"
                    FontAttributes="Bold" />

            <!-- Botón de Presentar -->
            <Button Text="Presentar Trámite" 
                    Command="{Binding PresentarCommand}" 
                    BackgroundColor="Green" 
                    TextColor="White"
                    FontAttributes="Bold" />

            <!-- Botón para limpiar los datos -->
            <Button Text="Limpiar / Nuevo Trámite" 
                    Command="{Binding NuevoTramiteCommand}" 
                    BackgroundColor="DarkRed" 
                    TextColor="White"
                    FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>