<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moviles2.Views.MainPage"
             Title="Trámite Vigilador"
             BackgroundColor="Black">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Carga de Trámite Local" FontSize="24" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />

            <!-- Estado actual siempre visible -->
            <Border BackgroundColor="#1E1E1E" Stroke="#FFB347" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                <Label Text="{Binding Tramite.EstadoGeneral}" TextColor="#FFB347" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            </Border>

            <!-- Nombre -->
            <Border BackgroundColor="#1E1E1E" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nombre del Solicitante:" TextColor="LightGray" FontSize="13" />
                    <Entry Text="{Binding Tramite.NombreSolicitante}" Placeholder="Ej: Juan Pérez" TextColor="White" PlaceholderColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Requisitos de Habilitación" FontSize="18" TextColor="White" FontAttributes="Bold" Margin="4,4,0,0" />

            <VerticalStackLayout Spacing="8">
                <!-- DNI -->
                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding Tramite.TieneDNI}" Color="#4CAF50" Scale="1.2" />
                        <Label Text="DNI Vigente" TextColor="White" FontSize="16" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Biométricos + Fecha -->
                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="12">
                            <CheckBox x:Name="ChkBiometricos" IsChecked="{Binding Tramite.TieneBiometricos}" Color="#4CAF50" Scale="1.2" />
                            <Label Text="Datos Biométricos" TextColor="White" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsChecked, Source={x:Reference ChkBiometricos}}" Margin="38,0,0,0">
                            <Label Text="Fecha:" TextColor="LightGray" VerticalOptions="Center" FontSize="14" />
                            <DatePicker Date="{Binding Tramite.FechaBiometricos}" TextColor="#FFB347" Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Secundario -->
                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding Tramite.TieneSecundario}" Color="#4CAF50" Scale="1.2" />
                        <Label Text="Título Secundario" TextColor="White" FontSize="16" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Curso + Fecha -->
                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="12">
                            <CheckBox x:Name="ChkCurso" IsChecked="{Binding Tramite.TieneCurso}" Color="#4CAF50" Scale="1.2" />
                            <Label Text="Curso de Capacitación" TextColor="White" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsChecked, Source={x:Reference ChkCurso}}" Margin="38,0,0,0">
                            <Label Text="Fecha:" TextColor="LightGray" VerticalOptions="Center" FontSize="14" />
                            <DatePicker Date="{Binding Tramite.FechaCurso}" TextColor="#FFB347" Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Reincidencia + Fecha -->
                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="12">
                            <CheckBox x:Name="ChkReincidencia" IsChecked="{Binding Tramite.TieneReincidencia}" Color="#4CAF50" Scale="1.2" />
                            <Label Text="Certificado de Reincidencia" TextColor="White" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsChecked, Source={x:Reference ChkReincidencia}}" Margin="38,0,0,0">
                            <Label Text="Fecha:" TextColor="LightGray" VerticalOptions="Center" FontSize="14" />
                            <DatePicker Date="{Binding Tramite.FechaReincidencia}" TextColor="#FFB347" Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding MensajeEstado}" TextColor="#FFB347" FontAttributes="Italic" HorizontalTextAlignment="Center" Margin="0,4" />

            <!-- Botones de acción -->
            <Button Text="Guardar Progreso"
                    Command="{Binding GuardarTramiteCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontAttributes="Bold" />

            <Button Text="Presentar Trámite"
                    Command="{Binding PresentarTramiteCommand}"
                    BackgroundColor="#FF9800"
                    TextColor="Black"
                    FontAttributes="Bold" />

            <Button Text="Ver Resumen"
                    Command="{Binding VerResumenCommand}"
                    BackgroundColor="#333333"
                    TextColor="White"
                    FontAttributes="Bold" />

            <Button Text="Mostrar Postulantes"
                    Command="{Binding MostrarPostulantesCommand}"
                    BackgroundColor="#1E88E5"
                    TextColor="White"
                    FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>