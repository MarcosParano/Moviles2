<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Moviles2.ViewModels"
             x:Class="Moviles2.Views.MainPage"
             Title="Mi Perfil"
             BackgroundColor="Black">

    <ContentPage.BindingContext>
        <vm:ProfileViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Título Principal -->
            <Label Text="Editar Perfil" 
                   Style="{StaticResource Headline}" 
                   HorizontalOptions="Center" 
                   SemanticProperties.HeadingLevel="Level1" 
                   TextColor="White" />

            <!-- Imagen de Perfil -->
            <Border HeightRequest="150" WidthRequest="150" 
                    HorizontalOptions="Center" Padding="0"
                    Stroke="LightGray" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="75" />
                </Border.StrokeShape>
                <Image Source="{Binding ImagenPerfil}" 
                       Aspect="AspectFill" />
            </Border>

            <!-- Formulario (Grid) -->
            <Grid RowDefinitions="Auto, Auto, Auto" 
                  ColumnDefinitions="Auto, *" 
                  RowSpacing="15" ColumnSpacing="10"
                  Margin="0, 20, 0, 0">

                <!-- Fila 0: Nombre -->
                <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" VerticalOptions="Center" FontAttributes="Bold" TextColor="White"/>

                <Border Grid.Row="0" Grid.Column="1" Stroke="DarkGray" StrokeThickness="1" BackgroundColor="#1A1A1A">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Nombre, Mode=TwoWay}" 
                           Placeholder="Tu nombre" 
                           TextColor="White" 
                           PlaceholderColor="Gray"
                           Margin="10,0"/>
                </Border>

                <!-- Fila 1: Edad -->
                <Label Grid.Row="1" Grid.Column="0" Text="Edad:" VerticalOptions="Center" FontAttributes="Bold" TextColor="White"/>

                <Border Grid.Row="1" Grid.Column="1" Stroke="DarkGray" StrokeThickness="1" BackgroundColor="#1A1A1A">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Edad, Mode=TwoWay}" 
                           Keyboard="Numeric" 
                           Placeholder="Tu edad" 
                           TextColor="White" 
                           PlaceholderColor="Gray"
                           Margin="10,0"/>
                </Border>

                <!-- Fila 2: Descripción -->
                <Label Grid.Row="2" Grid.Column="0" Text="Bio:" VerticalOptions="Start" FontAttributes="Bold" Margin="0,10,0,0" TextColor="White"/>

                <Border Grid.Row="2" Grid.Column="1" Stroke="DarkGray" StrokeThickness="1" BackgroundColor="#1A1A1A">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Editor Text="{Binding Descripcion, Mode=TwoWay}" 
                            HeightRequest="100" 
                            AutoSize="TextChanges"
                            Placeholder="Cuéntanos sobre ti" 
                            TextColor="White" 
                            PlaceholderColor="Gray"
                            Margin="10,5"/>
                </Border>
            </Grid>

            <!-- Mensaje de estado (Validaciones o Éxito) -->
            <Label Text="{Binding StatusMessage}" 
                   TextColor="{Binding StatusColor}" 
                   HorizontalOptions="Center" 
                   FontAttributes="Bold"
                   Margin="0, 10"/>

            <!-- Botón de Guardado -->
            <Button Text="Guardar" 
                    Command="{Binding SaveCommand}" 
                    HorizontalOptions="Fill" 
                    CornerRadius="8"
                    HeightRequest="50"
                    BackgroundColor="#2B0B98"
                    TextColor="White"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
