<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moviles2.Views.ResumenTramitePage"
             Title="Resumen del Trámite"
             BackgroundColor="Black">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Resumen del Trámite"
               FontSize="26"
               TextColor="#4CAF50"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Border BackgroundColor="#1E1E1E"
                Stroke="Gray"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="20">
            <VerticalStackLayout Spacing="12">

                <Label Text="Postulante:" TextColor="LightGray" FontSize="13" />
                <Label Text="{Binding Tramite.NombreSolicitante}"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold" />

                <Label Text="Estado Final:" TextColor="LightGray" FontSize="13" Margin="0,8,0,0" />
                <Label Text="{Binding Tramite.EstadoGeneral}"
                       TextColor="#FFB347"
                       FontSize="16"
                       FontAttributes="Bold" />

                <Label Text="Vencimiento de la Credencial:" TextColor="LightGray" FontSize="13" Margin="0,8,0,0" />
                <Label Text="{Binding TextoVencimiento}"
                       TextColor="White"
                       FontSize="16" />

            </VerticalStackLayout>
        </Border>

        <Button Text="Volver al Inicio"
                Command="{Binding VolverCommand}"
                BackgroundColor="#333333"
                TextColor="White"
                FontAttributes="Bold" />

    </VerticalStackLayout>
</ContentPage>