<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moviles2.Views.ResumenTramitePage"
             Title="Comprobante"
             BackgroundColor="Black">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">
        <Label Text="¡Trámite Presentado!" FontSize="28" TextColor="Green" FontAttributes="Bold" HorizontalOptions="Center" />
        
        <Border BackgroundColor="#1E1E1E" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="20">
            <VerticalStackLayout Spacing="10">
                <Label Text="Postulante:" TextColor="LightGray" />
                
                <Label Text="{Binding NombrePostulante}" TextColor="White" FontSize="20" FontAttributes="Bold" />
                
                <Label Text="Estado Final:" TextColor="LightGray" Margin="0,10,0,0" />
                <Label Text="Habilitado (Todos los requisitos OK)" TextColor="#FFB347" FontSize="16" />
                
                <Label Text="Vencimiento de la Credencial:" TextColor="LightGray" Margin="0,10,0,0" />
                
                <Label Text="{Binding FechaVencimientoStr}" TextColor="White" FontSize="18" />
            </VerticalStackLayout>
        </Border>

        <!-- Botón para volver al inicio -->
        <Button Text="Volver al Inicio" 
                Command="{Binding VolverCommand}" 
                BackgroundColor="#333333" 
                TextColor="White"
                FontAttributes="Bold"
                Margin="0,20,0,0" />
                
    </VerticalStackLayout>
</ContentPage>