<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moviles2.Views.DetalleApiPage"
             Title="Ficha Técnica API"
             BackgroundColor="Black">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Detalle del Postulante" FontSize="24" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>

            <Border BackgroundColor="#1E1E1E" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOMBRE COMPLETO" TextColor="LightGray" FontSize="11" FontAttributes="Bold"/>
                    <Label Text="{Binding Postulante.NombreSolicitante}" TextColor="White" FontSize="20" FontAttributes="Bold"/>

                    <Label Text="SITUACIÓN DEL TRÁMITE" TextColor="LightGray" FontSize="11" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Label Text="{Binding Postulante.EstadoGeneral}" TextColor="#FFB347" FontSize="15" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Checklist de Documentación" FontSize="18" TextColor="White" FontAttributes="Bold" Margin="4,8,0,0"/>

            <VerticalStackLayout Spacing="8">
                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,8">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding Postulante.TieneDNI}" InputTransparent="True" Color="#4CAF50" Scale="1.2"/>
                        <Label Text="DNI Vigente" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,8">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding Postulante.TieneBiometricos}" InputTransparent="True" Color="#4CAF50" Scale="1.2"/>
                        <Label Text="Datos Biométricos" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,8">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding Postulante.TieneSecundario}" InputTransparent="True" Color="#4CAF50" Scale="1.2"/>
                        <Label Text="Título Secundario" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,8">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding Postulante.TieneCurso}" InputTransparent="True" Color="#4CAF50" Scale="1.2"/>
                        <Label Text="Curso de Capacitación" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,8">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding Postulante.TieneReincidencia}" InputTransparent="True" Color="#4CAF50" Scale="1.2"/>
                        <Label Text="Certificado de Reincidencia" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Button Text="Volver a la Lista" 
                    Command="{Binding VolverCommand}" 
                    BackgroundColor="#333333" 
                    TextColor="White"
                    FontAttributes="Bold"
                    Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>